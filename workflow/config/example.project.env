# Project-specific settings for redeemV.
# Copy this file into a project Analysis_redeemV folder and edit it.

PROJECT_DIR=/path/to/project
OUT_ROOT="${PROJECT_DIR}/Analysis_redeemV"

REDEEM_V=/path/to/REDEEM-V
GENOME_PREFIX=/path/to/genomes/hg38.mitoMask

# REDEEM-V resources and analysis settings.
CUT=0
THREADS_STEP1=24
PREPROCESS_CORES=48
FILES_PER_CORE=1
MIN_BASE_QUALITY=30
MITO_GENOME=rCRS
BARCODE_TAG=BC

# Slurm settings.
ACCOUNT=your_slurm_account
PARTITION=20
MEM_PER_CPU_STEP1=8gb
MEM_PER_CPU_STEP2=8gb
MEM_PER_CPU_STEP3=16G
MEM_PER_CPU_STEP4=8gb

# Set to 1 to pass -q to MultiomeATAC_mito.sh and skip its QC section.
REDEEM_QUICK=0
