# Quickstart project config for the bundled REDEEM-V example data.
# This file is intended for dry-run validation and small tutorial runs.

PROJECT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
OUT_ROOT="${PROJECT_DIR}/Analysis_redeemV"

REDEEM_V=$(cd "${PROJECT_DIR}/../.." && pwd)
GENOME_PREFIX=/lab/solexa_weissman/cweng/Genomes/GRCH38/GRCH38_Bowtie2_MitoMask/hg38.mitoMask

# REDEEM-V resources and analysis settings.
CUT=0
THREADS_STEP1=8
PREPROCESS_CORES=4
FILES_PER_CORE=1
MIN_BASE_QUALITY=30
MITO_GENOME=rCRS
BARCODE_TAG=BC

# Slurm settings.
ACCOUNT=weissman
PARTITION=20
MEM_PER_CPU_STEP1=8gb
MEM_PER_CPU_STEP2=8gb
MEM_PER_CPU_STEP3=16G
MEM_PER_CPU_STEP4=8gb

# Set to 1 to pass -q to MultiomeATAC_mito.sh and skip its QC section.
REDEEM_QUICK=0
